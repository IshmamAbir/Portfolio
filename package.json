{
  "name": "portfolio",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "serve": "vite preview",
    "build": "vite build",
    "postbuild": "node -e \"require('node:fs').cpSync('files', 'dist/files', { recursive: true })\"",
    "test": "node --test tests/*.spec.js",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "dev": "vite",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist"
  },
  "dependencies": {
    "@mdi/font": "5.9.55",
    "pinia": "^2.0.32",
    "vue": "^3.2.47",
    "vue-i18n": "^9.14.4",
    "vue-router": "^4.1.6",
    "vue3-pdf-app": "^1.0.3",
    "vuetify": "^3.0.0-beta.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^4.0.0",
    "eslint": "^8.34.0",
    "eslint-plugin-vue": "^9.9.0",
    "gh-pages": "^6.3.0",
    "vite": "^4.1.4",
    "vite-plugin-vuetify": "^1.0.0-alpha.12"
  }
}
